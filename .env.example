PORT=3000
# Đặt NODE_ENV=production khi deploy. Ở production, thiếu JWT_SECRET thì server sẽ không khởi động.
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=shopdb
DB_SSL=false

# BẮT BUỘC: chuỗi ngẫu nhiên dài >= 32 ký tự. Tạo nhanh: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ── Triển khai ──
# Các domain được phép gọi API từ trình duyệt (phân tách bằng dấu phẩy). Để trống = cho phép tất cả (KHÔNG nên dùng ở production).
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# Số proxy phía trước server (Render = 1). Cần để giới hạn tần suất theo IP thật. Mặc định: 1 ở production, tắt ở môi trường khác.
# TRUST_PROXY=1
# Phí vận chuyển do server tính (phải khớp với trang thanh toán của storefront)
# FREE_SHIP_THRESHOLD=5000000
# SHIPPING_FEE=30000

# ── Quên mật khẩu (gửi email) ──
# Địa chỉ storefront, dùng để tạo liên kết đặt lại mật khẩu
FRONTEND_URL=http://localhost:3001
# Muốn gửi email thật: chạy `npm install nodemailer` rồi điền SMTP bên dưới.
# Nếu để trống: môi trường dev in liên kết ra console server; production không gửi gì (và không lộ token).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── Chatbot AI ──
# Mặc định dùng Google Gemini (có gói miễn phí). Lấy key tại https://aistudio.google.com → Get API key.
# Chỉ đặt key trong file .env (KHÔNG commit, KHÔNG đặt ở frontend). Mỗi biến chỉ một dòng.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Model. Để trống = gemini-3.5-flash (nếu key chưa dùng được model này, server tự thử gemini-flash-latest, gemini-3-flash-preview...).
# Lưu ý: Google tắt các model gemini-2.5-* từ 16/10/2026, đừng đặt AI_MODEL=gemini-2.5-flash nữa.
AI_MODEL=
# Mức "suy nghĩ" của Gemini 3.x: minimal | low (mặc định) | medium | high. Trả lời bị cắt/rỗng thì giảm mức này hoặc tăng AI_MAX_TOKENS.
# AI_THINKING_LEVEL=low

# Nhà cung cấp khác (xem CHATBOT.md, mục "Chọn nhà cung cấp AI"):
#   anthropic (Claude, trả phí) | gemini-openai (Gemini qua endpoint kiểu OpenAI, cách cũ) | ollama (chạy trên máy) | openai-compatible
# ANTHROPIC_API_KEY=            # chỉ khi AI_PROVIDER=anthropic — lấy tại https://console.anthropic.com/
# Ollama / dịch vụ khác: địa chỉ API (Ollama mặc định http://localhost:11434/v1; backend chạy trong Docker thì dùng http://host.docker.internal:11434/v1)
# AI_BASE_URL=
# AI_API_KEY=
# Chỉ cho endpoint kiểu OpenAI: low|medium|high|none; để rỗng (AI_REASONING_EFFORT=) để không gửi tham số này.
# AI_REASONING_EFFORT=
# Mạng công ty/trường học bắt buộc dùng proxy: đặt địa chỉ proxy và chạy "npm install undici" (Node không tự đọc HTTPS_PROXY)
# AI_PROXY_URL=
# Lỗi "Không kết nối được tới dịch vụ AI": chạy "npm run ai:check" để biết nguyên nhân (DNS, tường lửa, chứng chỉ, key...)
# Thời gian chờ AI trả lời (ms). Mặc định 45000, riêng Ollama 120000 vì chạy trên máy chậm hơn
# AI_TIMEOUT_MS=

AI_MAX_TOKENS=1500
# Số tin nhắn tối đa mỗi người dùng được gửi trong 1 phút
AI_RATE_LIMIT_PER_MIN=20
# Giới hạn số lần dùng các nút AI trên dashboard (gợi ý trả lời, mô tả sản phẩm, phân tích) mỗi phút / người
AI_FEATURE_RATE_LIMIT_PER_MIN=20

# ── Chat hỗ trợ khách hàng + trợ lý AI tự trả lời ──
# Có nhân viên trực tuyến: chờ bao lâu (ms) để nhân viên trả lời trước khi AI tự trả lời
SUPPORT_AI_DELAY_MS=45000
# Không có nhân viên nào trực tuyến: AI trả lời sau bao lâu (ms)
SUPPORT_AI_OFFLINE_DELAY_MS=1200
# Số tin AI tối đa mỗi hội thoại mỗi giờ (vượt quá thì tự chuyển cho nhân viên) — kiểm soát chi phí
SUPPORT_AI_MAX_PER_HOUR=20

# ── Cấu trúc database ──
# Khi khởi động, server so database với db/schema.sql. Không khớp thì cảnh báo (production: không khởi động).
# Sửa bằng:  npm run migrate-db -- --apply   (xem DATABASE.md). AUTO_MIGRATE=true: tự sửa mỗi lần khởi động (chỉ thêm/sửa, không xóa dữ liệu)
# AUTO_MIGRATE=false
# SKIP_SCHEMA_CHECK=false

# ── Mạng ──
# Mặc định ưu tiên IPv4 (tránh lỗi quá thời gian trên mạng có IPv6 hỏng, hay gặp trên Windows). verbatim = giữ mặc định của Node
# DNS_RESULT_ORDER=ipv4first
# NET_FAMILY_TIMEOUT_MS=1000

# Ghi log mỗi request (đặt false để tắt)
LOG_REQUESTS=true

# Múi giờ dùng khi AI hiểu "hôm nay", "tháng này"
APP_TIMEZONE=Asia/Ho_Chi_Minh
